rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function memberRole(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function isFamilyOwner(familyId) {
      return isFamilyMember(familyId) && memberRole(familyId) == 'owner';
    }

    function hasOptionalString(data, key) {
      return !data.keys().hasAny([key]) || data[key] is string;
    }

    function isHttpsString(value) {
      return value is string && value.matches('^https://.+');
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create, delete: if false;
      allow update: if isFamilyMember(familyId)
        && request.resource.data.keys().hasOnly([
          'name',
          'baseCurrency',
          'settings',
          'createdBy',
          'createdAt',
        ])
        && request.resource.data.name == resource.data.name
        && request.resource.data.baseCurrency == resource.data.baseCurrency
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read: if isFamilyOwner(familyId);
        allow write: if false;
      }

      match /stockItems/{itemId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll(['name', 'state', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.state is string
          && (!('updatedBy' in request.resource.data)
            || (request.resource.data.updatedBy is string
              && request.resource.data.updatedBy == request.auth.uid))
          && (!('conflictPolicy' in request.resource.data)
            || request.resource.data.conflictPolicy == 'lww-v1')
          && (!('clientUpdatedAt' in request.resource.data)
            || request.resource.data.clientUpdatedAt is timestamp);
        allow update: if isFamilyMember(familyId)
          && (!('updatedBy' in request.resource.data)
            || (request.resource.data.updatedBy is string
              && request.resource.data.updatedBy == request.auth.uid))
          && (!('conflictPolicy' in request.resource.data)
            || request.resource.data.conflictPolicy == 'lww-v1')
          && (!('clientUpdatedAt' in request.resource.data)
            || request.resource.data.clientUpdatedAt is timestamp);
        allow delete: if isFamilyMember(familyId);
      }

      match /paymentMethods/{methodId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll([
            'name',
            'type',
            'createdAt',
            'updatedAt',
            'createdBy'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type is string
          && request.resource.data.type in ['cash', 'debit', 'bank', 'credit_card', 'other']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy == request.auth.uid
          && (!('lastFour' in request.resource.data)
            || (request.resource.data.lastFour is string
              && request.resource.data.lastFour.size() <= 4
              && request.resource.data.lastFour.matches('^[0-9]*$')));
        allow update: if isFamilyMember(familyId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type is string
          && request.resource.data.type in ['cash', 'debit', 'bank', 'credit_card', 'other']
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.createdBy is string
          && (!('lastFour' in request.resource.data)
            || (request.resource.data.lastFour is string
              && request.resource.data.lastFour.size() <= 4
              && request.resource.data.lastFour.matches('^[0-9]*$')));
        allow delete: if isFamilyMember(familyId);
      }

      match /expenses/{expenseId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll([
            'amount',
            'categoryKey',
            'occurredAt',
            'createdAt',
            'updatedAt',
            'createdBy'
          ])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.categoryKey is string
          && request.resource.data.occurredAt is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy == request.auth.uid
          && (!('merchant' in request.resource.data) || request.resource.data.merchant is string)
          && (!('note' in request.resource.data) || request.resource.data.note is string)
          && (!('paymentMethodId' in request.resource.data)
            || request.resource.data.paymentMethodId is string)
          && (!('status' in request.resource.data)
            || request.resource.data.status in ['confirmed', 'pending_card_cycle', 'cancelled'])
          && (!('currency' in request.resource.data)
            || request.resource.data.currency in ['ARS', 'USD', 'EUR'])
          && (!('recurringTemplateId' in request.resource.data)
            || request.resource.data.recurringTemplateId is string)
          && (!('recurringPeriodKey' in request.resource.data)
            || request.resource.data.recurringPeriodKey is string)
          && (!('installmentIndex' in request.resource.data)
            || request.resource.data.installmentIndex is int)
          && (!('installmentTotal' in request.resource.data)
            || request.resource.data.installmentTotal is int);
        allow update: if isFamilyMember(familyId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.categoryKey is string
          && request.resource.data.occurredAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.createdBy is string
          && (!('paymentMethodId' in request.resource.data)
            || request.resource.data.paymentMethodId is string)
          && (!('status' in request.resource.data)
            || request.resource.data.status in ['confirmed', 'pending_card_cycle', 'cancelled'])
          && (!('currency' in request.resource.data)
            || request.resource.data.currency in ['ARS', 'USD', 'EUR'])
          && (!('recurringTemplateId' in request.resource.data)
            || request.resource.data.recurringTemplateId is string)
          && (!('recurringPeriodKey' in request.resource.data)
            || request.resource.data.recurringPeriodKey is string)
          && (!('installmentIndex' in request.resource.data)
            || request.resource.data.installmentIndex is int)
          && (!('installmentTotal' in request.resource.data)
            || request.resource.data.installmentTotal is int);
        allow delete: if isFamilyMember(familyId);
      }

      match /importJobs/{importJobId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      match /recurringTemplates/{templateId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll([
            'active',
            'amount',
            'categoryKey',
            'type',
            'generationDay',
            'createdAt',
            'updatedAt',
            'createdBy'
          ])
          && request.resource.data.active is bool
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.categoryKey is string
          && request.resource.data.type in ['fixed_monthly', 'installment']
          && request.resource.data.generationDay in ['month_start', 'month_end']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy == request.auth.uid
          && (!('paymentMethodId' in request.resource.data)
            || request.resource.data.paymentMethodId is string)
          && (!('merchant' in request.resource.data) || request.resource.data.merchant is string)
          && (!('note' in request.resource.data) || request.resource.data.note is string)
          && (!('totalInstallments' in request.resource.data)
            || (request.resource.data.totalInstallments is int
              && request.resource.data.totalInstallments >= 1))
          && (!('currentInstallment' in request.resource.data)
            || (request.resource.data.currentInstallment is int
              && request.resource.data.currentInstallment >= 1))
          && (!('lastGeneratedPeriod' in request.resource.data)
            || request.resource.data.lastGeneratedPeriod is string);
        allow update: if isFamilyMember(familyId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.active is bool
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.categoryKey is string
          && request.resource.data.type in ['fixed_monthly', 'installment']
          && request.resource.data.generationDay in ['month_start', 'month_end']
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.createdBy is string
          && (!('paymentMethodId' in request.resource.data)
            || request.resource.data.paymentMethodId is string)
          && (!('merchant' in request.resource.data) || request.resource.data.merchant is string)
          && (!('note' in request.resource.data) || request.resource.data.note is string)
          && (!('totalInstallments' in request.resource.data)
            || (request.resource.data.totalInstallments is int
              && request.resource.data.totalInstallments >= 1))
          && (!('currentInstallment' in request.resource.data)
            || (request.resource.data.currentInstallment is int
              && request.resource.data.currentInstallment >= 1))
          && (!('lastGeneratedPeriod' in request.resource.data)
            || request.resource.data.lastGeneratedPeriod is string);
        allow delete: if isFamilyMember(familyId);
      }

      match /sharedNotes/{noteId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll(['title', 'content', 'createdAt', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.content is string;
        allow update: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll(['title', 'content', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.content is string;
        allow delete: if isFamilyMember(familyId);
      }

      match /recipes/{recipeId} {
        // Alineado con RecipeDraft.toFirestore: metadatos de sync y tags opcional.
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.titulo is string
          && request.resource.data.descripcion is string
          && request.resource.data.ingredientes is list
          && request.resource.data.pasos is list
          && request.resource.data.tiempoMin is int
          && request.resource.data.porciones is int
          && request.resource.data.favorita is bool
          && request.resource.data.updatedBy is string
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.clientUpdatedAt is timestamp
          && request.resource.data.conflictPolicy is string
          && (!('tags' in request.resource.data) || request.resource.data.tags is list);
        allow update: if isFamilyMember(familyId)
          && request.resource.data.titulo is string
          && request.resource.data.descripcion is string
          && request.resource.data.ingredientes is list
          && request.resource.data.pasos is list
          && request.resource.data.tiempoMin is int
          && request.resource.data.porciones is int
          && request.resource.data.favorita is bool
          && request.resource.data.updatedBy is string
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.clientUpdatedAt is timestamp
          && request.resource.data.conflictPolicy is string
          && (!('tags' in request.resource.data) || request.resource.data.tags is list);
        allow delete: if isFamilyMember(familyId);
      }

      match /family_links/{linkId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll(['url', 'updatedAt'])
          && isHttpsString(request.resource.data.url)
          && hasOptionalString(request.resource.data, 'title')
          && hasOptionalString(request.resource.data, 'note');
        allow update: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll(['url', 'updatedAt'])
          && isHttpsString(request.resource.data.url)
          && hasOptionalString(request.resource.data, 'title')
          && hasOptionalString(request.resource.data, 'note');
        allow delete: if isFamilyMember(familyId);
      }

      match /billing/{docId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      match /billingEvents/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      // Auditoría de cierres / pagos de tarjeta (solo Cloud Functions / Admin SDK).
      match /expenseSettlementEvents/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      // Chat asistente: lectura para miembros; escritura solo Admin SDK (callable).
      match /assistantThreads/{threadId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isFamilyMember(familyId);
          allow write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
