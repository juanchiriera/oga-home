rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Client uploads for expense import (path created by startExpenseImport).
    match /families/{familyId}/expense-imports/{importJobId}/{fileName} {
      allow write: if request.auth != null
        && firestore.get(
          /databases/(default)/documents/families/$(familyId)/importJobs/$(importJobId)
        ).data.createdBy == request.auth.uid;
      allow read: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
